+                grupo_id, viajante_id, data_original, dados
+            )
+        except ValueError as erro:
+            tela.mostrar_erro(str(erro))
+            return False
+        except SQLAlchemyError:
+            tela.mostrar_erro("Não foi possível editar o dia do itinerário.")
+            return False
+        return True
